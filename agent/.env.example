GEMINI_API_KEY=
DEFAULT_TENANT=arsenio
# Postgres (Neon en Vercel). Sin esto, los mensajes se guardan en memoria (solo desarrollo).
DATABASE_URL=
# Sal para el hash de IP del rate limit
IP_HASH_SALT=
# Kill-switch manual: voice | text | all (vacío = todo activo)
AGENT_KILL_SWITCH=
# Alertas de presupuesto (50 % y 100 %) por correo. Con Gmail: activar verificación en dos
# pasos y crear una "contraseña de aplicación"; la @ del usuario va como %40.
#   SMTP_URL=smtps://tu.correo%40gmail.com:CONTRASEÑA_DE_APP@smtp.gmail.com:465
SMTP_URL=
ALERT_EMAIL_TO=
# Alternativa o complemento: webhook (ntfy.sh, Slack, Discord)
ALERT_WEBHOOK_URL=
