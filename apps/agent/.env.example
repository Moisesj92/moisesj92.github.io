# --- Obligatorias ---------------------------------------------------------
# Google AI Studio (free tier). Sin ella no hay voz ni texto.
GEMINI_API_KEY=
# Tenant por defecto cuando la petición no lo indica
DEFAULT_TENANT=arsenio

# --- Base de datos (Neon en Vercel; Vercel también inyecta POSTGRES_URL) ---
# Sin ella, mensajes y contadores van a memoria (solo desarrollo).
DATABASE_URL=

# --- Contención de abuso --------------------------------------------------
# Sal del hash de IP para el rate limit (cadena aleatoria larga)
IP_HASH_SALT=
# Cloudflare Turnstile (anti-bot antes de emitir tokens de voz). Sin el secret, se omite.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Kill-switch manual: voice | text | all (vacío = todo activo). El de /admin aplica al instante.
AGENT_KILL_SWITCH=

# --- Alertas de presupuesto (50 % y 100 %) --------------------------------
# Correo por SMTP. Con Gmail: verificación en dos pasos + "contraseña de aplicación";
# la @ del usuario va como %40. Ej.: smtps://correo%40gmail.com:CONTRASEÑA@smtp.gmail.com:465
SMTP_URL=
ALERT_EMAIL_TO=
# Alternativa o complemento: webhook (ntfy.sh, Slack, Discord)
ALERT_WEBHOOK_URL=

# --- Panel /admin -----------------------------------------------------------
# Sin esto el panel no abre. Cambiarla cierra todas las sesiones.
ADMIN_PASSWORD=
